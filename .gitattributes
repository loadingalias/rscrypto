# Normalize text files; check them out with LF.
* text=auto eol=lf

# Windows scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Fuzz inputs must retain their exact bytes on every host.
fuzz/corpus/** binary
fuzz-packages/*/corpus/** binary

# Unified-diff context lines preserve blank-line spaces and upstream tabs.
scripts/test/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab


testdata/ascon/asconaead128.txt -diff
