{
  "schema": 1,
  "benches": {
    "crc": {
      "binary": "crc",
      "kind": "criterion",
      "required": true,
      "features": ["std", "checksums"]
    },
    "sha2": {
      "binary": "sha2",
      "kind": "criterion",
      "required": true,
      "features": ["std", "sha2", "diag"]
