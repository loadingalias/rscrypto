  "case_classes": {
    "sha2": {
      "diagnostic": [
        "/internal/"
      ]
    },
    "auth": {
      "diagnostic": [
        "/internal/",
        "^ed25519/verify-phase/"
      ],
      "expensive": [
        "^pbkdf2-"
      ]
    },
    "password_hashing": {
      "expensive": [
        "^"
      ]
    },
    "rsa": {
      "diagnostic": [
        "^rsa-(hash-components|montgomery-thresholds)/",
        "/(blinding-inverse|padding-)",
        "-(bitserial-baseline|product-montgomery|generic-exponent|cios-candidate|cios-portable)$"
      ],
      "expensive": [
        "^rsa-[0-9]+-private-signing/"
      ]
    },
    "aead": {
      "diagnostic": [
        "^chacha20-poly1305/copy-and-(encrypt|decrypt)/rscrypto-(owned|x86-asm)/"
      ]
    },
    "aead_kernels": {
      "diagnostic": [
        "^"
      ]
    },
    "blake3": {
      "diagnostic": [
        "/rscrypto-[^/]+/",
        "^blake3/(xof-output|chunk-tail-digest|chunk-tail-cvs|parent-tail-cvs)/"
