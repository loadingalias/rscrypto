      "kind": "criterion",
      "required": true,
      "features": ["std", "websocket-sha1"]
    },
    "kmac_cshake": {
      "binary": "kmac_cshake",
      "kind": "criterion",
      "required": true,
      "features": ["std", "sha3", "kmac"]
    },
    "ascon": {
      "binary": "ascon",
      "kind": "criterion",
      "required": true,
      "features": ["std", "ascon-hash"]
