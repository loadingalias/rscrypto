+                let mut algorithms = provider.signature_verification_algorithms;
+                algorithms.mapping = Box::leak(algorithms.mapping.iter().copied().filter(|(scheme, _)| {
+                    !matches!(scheme, SignatureScheme::ML_DSA_44 | SignatureScheme::ML_DSA_65 | SignatureScheme::ML_DSA_87)
+                }).collect::<Vec<_>>().into_boxed_slice());
