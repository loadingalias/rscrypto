diff --git a/quinn-interop/Cargo.toml b/quinn-interop/Cargo.toml
index 33d53df..c5085d7 100644
--- a/quinn-interop/Cargo.toml
+++ b/quinn-interop/Cargo.toml
@@ -6,15 +6,25 @@ version = "0.0.0"
 authors = ["Jean-Christophe BEGUE <jc.begue@pm.me>"]
 edition = "2018"
 
+[workspace]
+
+# h3-quinn 0.0.10 with only its Quinn requirement moved to the provider's revision.
+[patch.crates-io]
+h3 = { path = "@H3_ROOT@/h3" }
+h3-quinn = { path = "@H3_ROOT@/h3-quinn" }
+
 [dependencies]
 anyhow = "1.0.86"
 bytes = "1"
-h3 = "0.0.6"
-h3-quinn = "0.0.7"
+h3 = "=0.0.8"
+h3-quinn = { version = "=0.0.10", default-features = false }
 http = "1"
-quinn = { version = "0.11.2", default-features = false, features = [ "rustls", "ring", "runtime-tokio" ] }
-rustls = { version = "0.23", default-features = false }
+quinn = { version = "=0.12.0", git = "https://github.com/quinn-rs/quinn", rev = "9d729c1b6b7ad30d45d40265037eeeb9d98a7420", default-features = false, features = [ "runtime-tokio" ] }
+rustls = { version = "=0.24.0-dev.2", git = "https://github.com/rustls/rustls", rev = "7ebba67075b0c3c2b8fe20c470d5c53410866544", default-features = false, features = ["webpki"] }
+rustls-util = { version = "=0.1.0-dev.1", git = "https://github.com/rustls/rustls", rev = "7ebba67075b0c3c2b8fe20c470d5c53410866544", default-features = false }
+rscrypto-rustls = { path = "@RSCRYPTO_ROOT@/rscrypto-rustls", features = ["quinn"] }
 rustls-pemfile = "2"
-tokio = { version = "1", features = ["rt", "macros", "rt-multi-thread", "io-std", "io-util", "fs"] }
+# Quinn's revision declares tokio 1.28.1 but needs `OwnedNotified` from a later release.
+tokio = { version = "1.53.3", features = ["rt", "macros", "rt-multi-thread", "io-std", "io-util", "fs"] }
 tracing = "0.1.10"
 tracing-subscriber = { version = "0.3.18", default-features = false, features = ["fmt", "ansi", "env-filter", "chrono", "tracing-log"] }
