#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Queue qualification of the pushed commit. The checkout must be that commit, unchanged.
head=$(git rev-parse HEAD)
pushing=false
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ ! "$local_sha" =~ ^0+$ ]] || continue # Deleting a remote ref pushes no source.
  [[ "$local_sha" == "$head" ]] || {
    echo "Pre-push qualifies the checked-out commit; check out $local_ref and push again." >&2
    exit 1
  }
  pushing=true
done
[[ "$pushing" == true ]] || exit 0

clean() {
  git diff --quiet && git diff --cached --quiet && [[ -z "$(git ls-files --others --exclude-standard)" ]]
}
clean || { echo 'Commit or set aside every change before pushing; qualification tests the checkout.' >&2; exit 1; }
scripts/lib/python.sh scripts/check/macos_async.py queue "$2" "$head"
